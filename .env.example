# ===========================================
# AI IT Service Desk — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ---------- Database ----------
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=servicedesk
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=servicedesk;Username=servicedesk;Password=CHANGE_ME_postgres_password

# ---------- JWT ----------
JWT_SECRET_KEY=CHANGE_ME_at_least_32_characters_long_secret_key
JWT_ISSUER=ServiceDesk
JWT_AUDIENCE=ServiceDeskClient
JWT_EXPIRY_MINUTES=60

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=servicedesk
MINIO_USE_SSL=false

# ---------- AI Provider ----------
AI_PROVIDER=NoOp

# ---------- Application ----------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
