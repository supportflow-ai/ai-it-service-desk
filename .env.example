# Sao chép thành .env ở gốc repo; file .env bị Git ignore.
# Công cụ run_backend.py nạp file vào riêng tiến trình con.
# Biến môi trường hiện có được ưu tiên; không nội suy biến hoặc thực thi shell.
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
Database__ConnectionString=Host=127.0.0.1;Port=5432;Database=servicedesk;Username=servicedesk;Password=SET_LOCALLY
# Khóa ngẫu nhiên >= 32 byte UTF-8, tạo một lần và lưu lại; không dùng access token.
Jwt__SecretKey=
Jwt__Issuer=ServiceDesk
Jwt__Audience=ServiceDeskClient
Jwt__ExpiryMinutes=60
# Hiện đăng nhập và ticket chưa dùng lưu tệp; chỉ điền MinIO khi có dịch vụ thật.
Minio__Endpoint=localhost:9000
Minio__AccessKey=
Minio__SecretKey=
Minio__Bucket=servicedesk
Minio__UseSsl=false
# Metadata không bí mật để đối chiếu đích trước thao tác database.
SD_DB_HOST=127.0.0.1
SD_DB_PORT=5432
SD_DB_NAME=servicedesk
# Chỉ thêm khi dùng database VPS qua SSH; mỗi người có tài khoản/key riêng.
# DatabaseTunnel__Host=DIEN_HOST_VPS
# DatabaseTunnel__SshUser=DIEN_TAI_KHOAN_DUOC_CAP
# DatabaseTunnel__PrivateKeyPath=~/.ssh/DIEN_TEN_PRIVATE_KEY
# DatabaseTunnel__SshPort=22
# DatabaseTunnel__LocalPort=15432
# DatabaseTunnel__RemotePort=5432
# Khi dùng tunnel: sửa Port trong chuỗi kết nối và SD_DB_PORT thành 15432,
# đồng thời dùng đúng tên database/user/mật khẩu được cấp, không dùng mẫu local.
