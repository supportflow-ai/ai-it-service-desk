<Project Sdk="Microsoft.NET.Sdk">

  <!-- Module Ticketing: Domain, Application, Infrastructure và Presentation nằm trong cùng một project,
       tách bằng thư mục/namespace; ranh giới tầng được kiểm bằng ServiceDesk.ArchitectureTests. -->
  <PropertyGroup>
    <RootNamespace>ServiceDesk.Modules.Ticketing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\ServiceDesk.SharedKernel\ServiceDesk.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ServiceDesk.SharedKernel.Web\ServiceDesk.SharedKernel.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ghim EF Core quan hệ cùng phiên bản với Identity.EntityFrameworkCore để mọi project dùng một bản EF. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceDesk.Application.Tests" />
    <InternalsVisibleTo Include="ServiceDesk.IntegrationTests" />
  </ItemGroup>

</Project>
